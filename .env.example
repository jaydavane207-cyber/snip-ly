# ==============================================================================
# Environment Variables Example for Snip.ly (Vercel & Local)
# Copy this file to .env or configure these variables in Vercel Project Settings.
# ==============================================================================

# PostgreSQL Connection String
# Local Docker: postgresql://postgres:postgres@localhost:5432/urldb?schema=public
# Production / Cloud: Get from Neon (https://neon.tech), Supabase (https://supabase.com), or Vercel Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urldb?schema=public"

# Redis Connection URL
# Local Docker: redis://localhost:6379
# Production / Serverless: Get from Upstash Redis (https://upstash.com) - use rediss:// for TLS encryption
REDIS_URL="redis://localhost:6379"

# Application Base URL
# Local: http://localhost:3000
# Production: Your deployed Vercel domain or custom domain (e.g. https://snip-ly.vercel.app)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Clerk Authentication (Optional)
# Get from Clerk Dashboard (https://dashboard.clerk.com) > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Google Gemini AI API Key (Optional, for AI-generated aliases and metadata)
# Get a free key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="AIzaSy..."
