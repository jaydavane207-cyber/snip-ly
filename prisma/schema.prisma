generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Link {
  id                 String     @id @default(cuid())
  originalUrl        String
  shortCode          String     @unique
  userId             String?
  title              String?
  description        String?
  faviconUrl         String?
  folder             String?    @default("General")
  tags               String[]   @default([])
  isFavorite         Boolean    @default(false)
  showOnBio          Boolean    @default(false)
  bioTitle           String?
  passwordHash       String?
  maxClicks          Int?
  clickCount         Int        @default(0)
  isActive           Boolean    @default(true)
  expiresAt          DateTime?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  splitDestinations  Json?
  createdAt          DateTime   @default(now())
  clicks             Click[]
  rules              LinkRule[]

  @@index([shortCode])
  @@index([userId])
}

model LinkRule {
  id             String   @id @default(cuid())
  linkId         String
  link           Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  type           String   // "country" | "device"
  value          String
  destinationUrl String
  createdAt      DateTime @default(now())

  @@index([linkId])
}

model Click {
  id        String   @id @default(cuid())
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  country   String?
  device    String?
  browser   String?
  os        String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([linkId, createdAt])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  username    String   @unique
  displayName String?
  bio         String?
  avatarUrl   String?
  theme       String?  @default("indigo")
  socialLinks Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([username])
  @@index([userId])
}

model Webhook {
  id        String   @id @default(cuid())
  userId    String
  url       String
  event     String   @default("milestone")
  secret    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}
